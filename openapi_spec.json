{
  "openapi": "3.1.0",
  "info": {
    "title": "PaO2/FiO2 & Berlin oxygenation calculator",
    "version": "3.0.0",
    "description": "Subset of API routes. The running FastAPI /openapi.json is authoritative; the Berlin oxygenation category is not an ARDS diagnosis."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "Service metadata"
          }
        }
      }
    },
    "/api/assessment": {
      "post": {
        "summary": "Calculate oxygenation metrics",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pao2": {
                    "type": "number"
                  },
                  "fio2": {
                    "type": "number"
                  },
                  "paco2": {
                    "type": "number"
                  },
                  "peep": {
                    "type": "number"
                  },
                  "map_pressure": {
                    "type": "number"
                  },
                  "age": {
                    "type": "number"
                  },
                  "spo2": {
                    "type": "number"
                  },
                  "patm": {
                    "type": "number"
                  }
                },
                "required": [
                  "pao2",
                  "fio2"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Computed oxygenation metrics with caveats"
          },
          "422": {
            "description": "Invalid measurement"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Demonstration audit endpoint (not clinical)",
        "responses": {
          "200": {
            "description": "Demonstration dossier"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Demonstration mock chat endpoint",
        "responses": {
          "200": {
            "description": "Mock response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read audit logs with X-Admin-Key",
        "responses": {
          "200": {
            "description": "In-memory HMAC ledger"
          },
          "403": {
            "description": "Admin access required"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Return JSON audit processing counters",
        "responses": {
          "200": {
            "description": "JSON counters"
          }
        }
      }
    }
  }
}
